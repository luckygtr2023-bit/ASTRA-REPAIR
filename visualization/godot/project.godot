; Engine configuration file.
; Format: [section] param=value

config_version=5

[application]

name="ASTRA COSMOS — Visualization"
run/main_scene="res://phase_01_foundation/scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://phase_01_foundation/assets/icon.svg"
boot_splash/bg_color=Color(0.02, 0.02, 0.08, 1)

[autoload]

AstraBridge="*res://phase_01_foundation/scripts/astra_bridge.gd"
QualityPresets="*res://phase_01_foundation/scripts/quality_presets.gd"
Telemetry="*res://phase_01_foundation/scripts/telemetry.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_environment="res://phase_01_foundation/environments/default_env.tres"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=2
textures/canvas_textures/default_texture_repeat=0

[input]

orbit_modifier={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"command_or_control_autopressed":false,"control_pressed":false,"pressed":false,"keycode":4194330,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}
free_camera_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"command_or_control_autopressed":false,"control_pressed":false,"pressed":false,"keycode":4194320,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":0,"button_index":12,"pressure":0.0,"pressed":false,"pressed_before":false,"strength":0.0,"script":null)
]
}

[physics]

common/physics_ticks_per_second=60

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1
