#version 450
#extension GL_GOOGLE_include_directive : require
#include "common/common.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=0) uniform Params { float temp; float density; float B; float velocity; } params;
layout(std430,binding=1) buffer Out { vec4 color[]; } out_buf;
void main(){
    uint id = gl_GlobalInvocationID.x;
    float t = params.temp / 1e7; // scientific param temp drives emissive
    vec3 col = vec3(t, t*0.5, 0.1);
    out_buf.color[id] = vec4(col, 1.0);
}
