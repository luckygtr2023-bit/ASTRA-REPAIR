# ASTRA COSMOS — Supabase Product Layer
# Copy to .env for local development: cp .env.example .env
# NEVER commit .env — it is gitignored.
# Publishable key is client-safe because RLS enforces security, not key secrecy.

# Required — centralized via ASTRA_ prefix (preferred)
ASTRA_SUPABASE_URL=https://your-project.supabase.co
ASTRA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Alternative fallbacks (also supported):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Google OAuth is configured in Supabase Dashboard (Auth → Providers → Google)
# Do NOT put GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET here or in Git.
# If you need local OAuth, set them as environment variables in your shell or CI:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional product layer
ASTRA_SUPABASE_OFFLINE_MODE=false
# ASTRA_SUPABASE_TIMEOUT_MS=5000
