#version 450
// Impact Spark — GPU particles RANDOM_SEED deterministic, AAA 1M
layout(local_size_x=64) in;
layout(set=0,binding=0) buffer ParticlesPos { vec4 pos_vel[]; } particlesPos;
layout(set=0,binding=1) buffer ParticlesColor { vec4 color_life[]; } particlesColor;
layout(set=0,binding=2) uniform Params { float dt; uint seed; uint count; } params;
// Deterministic hash vs RANDOM_SEED
float hash(uint x){ return fract(sin(float(x)*12.9898)*43758.5453); }
void main(){
    uint id = gl_GlobalInvocationID.x;
    if(id >= params.count) return;
    uint s = params.seed + id*1664525u + 1013904223u;
    vec3 vel = vec3(hash(s), hash(s+1u), hash(s+2u))*2.0-1.0;
    vec3 pos = particlesPos.pos_vel[id].xyz + vel * params.dt;
    float life = particlesColor.color_life[id].w - params.dt;
    particlesPos.pos_vel[id] = vec4(pos, 0);
    particlesColor.color_life[id].w = life;
}
